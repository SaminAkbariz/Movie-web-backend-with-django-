# این فایل را کپی کنید و به نام .env ذخیره کنید، سپس مقادیر واقعی را جایگزین کنید
# cp .env.example .env

# یک SECRET_KEY تصادفی و امن بسازید، مثلا با:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-random-secret-key

# روی سرور (production) حتما False بگذارید
DEBUG=True

# دامنه‌ها/آی‌پی‌های مجاز، جدا شده با کاما
ALLOWED_HOSTS=localhost,127.0.0.1
